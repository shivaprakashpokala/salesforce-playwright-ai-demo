# Copy to .env and fill in. Never commit .env or the private key.

# Your org's My Domain login URL and the user the tests run as.
SF_LOGIN_URL=https://your-domain.develop.my.salesforce.com
SF_USERNAME=you@example.com

# --- Preferred: JWT sign-in (no password, no verification code) ---
# Consumer key of the External Client App / Connected App.
SF_CLIENT_ID=
# Path to the private key that matches the certificate uploaded to the app...
SF_PRIVATE_KEY_PATH=.auth/server.key
# ...or the key itself on one line with \n for line breaks (used for CI secrets).
# SF_PRIVATE_KEY=
# Sandboxes only: SF_JWT_AUDIENCE=https://test.salesforce.com

# --- Fallback: password sign-in (may be stopped by an emailed verification code) ---
# SF_PASSWORD=
